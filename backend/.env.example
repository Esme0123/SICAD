# ── Base de datos (PostgreSQL) ──
DATABASE_URL="postgresql://usuario:password@host:5432/sicad?sslmode=require"

# ── Seguridad ──
JWT_SECRET="cambia-esta-clave-en-produccion"
QR_SECRET_KEY="cambia-esta-clave-en-produccion"
# WebPush VAPID Keys (Generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sicad.app
# ── Correo (SendGrid) ──────────────────────────────────────
# Obtén tu API Key en: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxx
# Remitente verificado en SendGrid
SMTP_USER=esm.med123@gmail.com
FRONTEND_URL=http://localhost:5173

# ── Servidor ──
PORT=3000
NODE_ENV=development

# ── QR (opcional, default 30s) ──
QR_VALIDITY_SECONDS=30
