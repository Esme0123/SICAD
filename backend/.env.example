# ── Base de datos (PostgreSQL) ──
DATABASE_URL="postgresql://usuario:password@host:5432/sicad?sslmode=require"

# ── Seguridad ──
JWT_SECRET="cambia-esta-clave-en-produccion"
QR_SECRET_KEY="cambia-esta-clave-en-produccion"
# WebPush VAPID Keys (Generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sicad.app
# ── Correo (Resend) ─────────────────────────────────────────
# Obtén tu API Key en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Remitente (por defecto onboarding@resend.dev en plan gratuito)
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:5173

# ── Servidor ──
PORT=3000
NODE_ENV=development

# ── QR (opcional, default 30s) ──
QR_VALIDITY_SECONDS=30
