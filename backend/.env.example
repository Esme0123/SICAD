# ── Base de datos (PostgreSQL) ──
DATABASE_URL="postgresql://usuario:password@host:5432/sicad?sslmode=require"

# ── Seguridad ──
JWT_SECRET="cambia-esta-clave-en-produccion"
QR_SECRET_KEY="cambia-esta-clave-en-produccion"
# WebPush VAPID Keys (Generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sicad.app
# ── Correo SMTP (Gmail) ─────────────────────────────────────
# Para usar Gmail: habilita la verificación en 2 pasos y genera
# una "Contraseña de aplicación" de 16 caracteres en:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo_oficial@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion_16_caracteres
FRONTEND_URL=http://localhost:5173

# ── Servidor ──
PORT=3000
NODE_ENV=development

# ── QR (opcional, default 30s) ──
QR_VALIDITY_SECONDS=30
